# Copy to .env and fill in whichever providers you want to use.
# Neither key is required: the "mock" provider runs the whole system offline.

# Paid. Used for the Claude arms of the experiment.
ANTHROPIC_API_KEY=

# Free tier: https://console.groq.com/keys
# This is the capability axis -- weaker open models are where the pipeline's
# structured input should start to beat raw log text.
GROQ_API_KEY=

# Optional: override the Groq model picker. Ids rotate as models are retired,
# so leaving this unset asks the Groq API for its live model list instead.
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
